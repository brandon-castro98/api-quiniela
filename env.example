# Configuración de la base de datos
DATABASE_URL=postgresql://usuario:password@localhost:5432/quinielas_db

# Configuración de Django
SECRET_KEY=tu-secret-key-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api-quiniela-phiv.onrender.com

# Configuración de CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Configuración de Firebase (opcional para desarrollo)
# FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
# FIREBASE_CONFIG={"type": "service_account", "project_id": "tu-proyecto", ...}

# Configuración de logging
LOG_LEVEL=INFO
